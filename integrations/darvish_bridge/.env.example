# Copy to .env. Never commit real values.
DB_PASSWORD=SET_A_STRONG_UNIQUE_DATABASE_PASSWORD
TELEGRAM_BOT_TOKEN=PUT_YOUR_BOTFATHER_TOKEN_HERE
ADMIN_TELEGRAM_IDS=123456789
APP_SECRET=GENERATE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
DATABASE_URL=postgresql+psycopg://darvish:replace_password@db:5432/darvish
PUBLIC_BASE_URL=https://bridge.example.com
# Comma-separated hostnames you explicitly trust for outbound merchant callbacks.
WEBHOOK_ALLOWED_HOSTS=merchant.example.com
SETTLEMENT_CYCLE_HOURS=24

# Explicit opt-in; digital products remain accurately labelled digital.
ALLOW_DIGITAL_MANUAL_RECEIPTS=0
BRIDGE_API_PORT=8095
