# D Bot environment example
# Copy this file to .env and replace every CHANGE_ME value before running.
# Never commit the real .env file.

# Telegram
BOT_TOKEN=CHANGE_ME_BOT_TOKEN
OWNER_IDS=123456789
ADMIN_IDS=
SELLER_IDS=
DEFAULT_CHANNEL_URL=https://t.me/example

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://dbot:CHANGE_ME_DB_PASSWORD@db:5432/d_bot
POSTGRES_DB=d_bot
POSTGRES_USER=dbot
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Redis
REDIS_URL=redis://redis:6379/0

# API and runtime
API_HOST=0.0.0.0
API_PORT=8000
TZ=Asia/Tehran
SERVER_SYNC_SECONDS=300
SERVER_SYNC_CONCURRENCY=4

# Web admin and cryptography
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
WEB_PATH=dbot
PUBLIC_BASE_URL=
ADMIN_MAX_LOGIN_ATTEMPTS=8
ADMIN_LOGIN_LOCK_SECONDS=900
JWT_SECRET=CHANGE_ME_JWT_SECRET
FERNET_KEY=CHANGE_ME_FERNET_KEY

# NOWPayments (optional)
NOWPAYMENTS_ENABLED=false
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_PAY_CURRENCY=trx
NOWPAYMENTS_PRICE_CURRENCY=usd
NOWPAYMENTS_IPN_CALLBACK_URL=

# X-UI TLS
XUI_VERIFY_TLS=true
XUI_CA_BUNDLE=
# X-UI/Sanaei HTTP resilience (seconds)
XUI_CONNECT_TIMEOUT_SECONDS=8
XUI_READ_TIMEOUT_SECONDS=35
XUI_WRITE_TIMEOUT_SECONDS=25
XUI_POOL_TIMEOUT_SECONDS=8
XUI_READ_RETRY_ATTEMPTS=3
# 3x-ui v3.8.0 pooled API sessions / keep-alive
XUI_AUTH_CACHE_SECONDS=180
XUI_MAX_CONNECTIONS=40
XUI_MAX_KEEPALIVE_CONNECTIONS=20
XUI_KEEPALIVE_EXPIRY_SECONDS=30

# Runtime pools (increase only if the VPS has enough RAM/file descriptors)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
REDIS_MAX_CONNECTIONS=50
TELEGRAM_HTTP_TIMEOUT_SECONDS=20
TELEGRAM_HTTP_CONNECTION_LIMIT=100

# Backup and administrative operations
# Maximum portable JSON restore size (100 MiB by default)
BACKUP_MAX_UPLOAD_BYTES=104857600
# Legacy formats 1-3 only. Portable format 4 is cross-installation.
BACKUP_REQUIRE_SIGNATURE=true
BACKUP_SIGNING_SECRET=
DBOT_ALLOW_DOCKER_RESTART=false
